# ── Production Environment Variables ──────────────────────────────────────────────
# Copy this file to .env.prod and fill in your actual values
# This file should NOT be committed to version control

# ── AWS Credentials (for local development only - use IAM roles in production) ──
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# ── ECR Configuration ─────────────────────────────────────────────────────────────
ECR_REPOSITORY_URI=your_account_id.dkr.ecr.us-east-1.amazonaws.com/multi-rag-platform
IMAGE_TAG=latest

# ── Database Configuration ────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_USER=raguser
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=rag_eval
MYSQL_PORT=3306

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────────
QDRANT_URL=https://your-qdrant-instance.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# ── OpenAI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Cohere ────────────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key

# ── Application Settings ──────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── LangSmith ─────────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=Multi_Agent_RAG_Platform

# ── Ports ─────────────────────────────────────────────────────────────────────────
API_PORT=8000
MYSQL_PORT=3306