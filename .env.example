# ─── LLM ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ─── MySQL ─────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=ragdb

# ─── Qdrant Cloud ────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=rag_documents

# ─── App ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

#----- Langsmith Configuration -----
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=Multi_Agent_RAG_Platform

# ── Re-ranking ─────────────────────────────────────────────────────────
cohere_api_key=your-cohere-api-key

# ── GitHub Checks ─────────────────────────────────────────────────────────
github_api_token=your-github-token
github_repo=your-username/your-repo
github_head_sha=your-head-sha
github_check_name=RAGAS Evaluation
github_failure_threshold=0.8