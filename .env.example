# ─── LLM ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-ada-002

# ─── MySQL ─────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=raguser
MYSQL_PASSWORD=ragpassword
MYSQL_DATABASE=rag_eval

# ─── Qdrant Cloud ────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=rag_documents

# ─── App ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
