# ── Production Environment Configuration ─────────────────────────────────────────
# This file contains default values for production deployment
# Actual secrets should be injected via AWS Secrets Manager or Parameter Store

# ── LLM ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── MySQL ────────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_eval

# ── Qdrant Cloud ─────────────────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# ── RAG parameters ───────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
BM25_CANDIDATE_MULTIPLIER=5
HYDE_GENERATION_COUNT=3
HYDE_SEARCH_MULTIPLIER=2
QUERY_REWRITE_MODEL=gpt-4o-mini
HYDE_MODEL=gpt-4o-mini
DENSE_SPARSE_MIX_WEIGHT=0.65

# ── Cohere ───────────────────────────────────────────────────────────────────────
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# ── App ──────────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── LangSmith ────────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Multi_Agent_RAG_Platform

# ── GitHub Checks ────────────────────────────────────────────────────────────────
GITHUB_API_TOKEN=
GITHUB_REPO=
GITHUB_HEAD_SHA=
GITHUB_CHECK_NAME=RAGAS Evaluation
GITHUB_FAILURE_THRESHOLD=0.1